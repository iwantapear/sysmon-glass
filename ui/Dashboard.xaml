<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="系统状态 · Glass" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent"
 WindowStartupLocation="Manual" ShowInTaskbar="True" ShowActivated="False" FontFamily="Microsoft YaHei UI" Foreground="#FFF4F7FF" UseLayoutRounding="True">
 <Window.Resources>
   <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Style.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.45"/></Trigger>
     <Trigger Property="IsMouseCaptureWithin" Value="True"><Setter Property="Opacity" Value="0.55"/></Trigger>
    </Style.Triggers>
   </Style>
  <Style x:Key="GlassButtonStyle" TargetType="Button">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonSurface" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.60"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="Root">
  <Ellipse x:Name="AmbientTop" Width="900" Height="500" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-40,0" IsHitTestVisible="False">
   <Ellipse.Fill><RadialGradientBrush><GradientStop x:Name="GlowTop0" Color="#3875A7FF" Offset="0"/><GradientStop x:Name="GlowTop1" Color="#0075A7FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
  </Ellipse>
  <Ellipse x:Name="AmbientBottom" Width="850" Height="380" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-60,0,0,-100" IsHitTestVisible="False">
   <Ellipse.Fill><RadialGradientBrush><GradientStop x:Name="GlowBottom0" Color="#2B74E8D8" Offset="0"/><GradientStop x:Name="GlowBottom1" Color="#0074E8D8" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
  </Ellipse>
  <Viewbox x:Name="DashboardView" Stretch="Uniform">
   <Grid x:Name="DashboardGrid" Width="1600" Height="900" Margin="0">
    <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
    <Grid x:Name="Header" Margin="48,0,48,0" Background="Transparent">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="HeaderEyebrow" Text="SYSTEM  /  LIVE MONITOR" FontSize="12" FontWeight="SemiBold" Foreground="#FF9CB8E9"/><TextBlock x:Name="HeaderTitle" Text="系统状态" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
     <Border x:Name="StatusBorder" Grid.Column="1" Padding="16,8" CornerRadius="18" BorderThickness="1" BorderBrush="#50B5E3FF" Background="#40203143" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FFFF727C" Margin="0,0,10,0"/><TextBlock x:Name="StatusText" Text="DGX 连接中" FontSize="14" Foreground="#FFDCE8F7"/></StackPanel></Border>
     <Button x:Name="ThemeButton" Style="{StaticResource GlassButtonStyle}" Grid.Column="2" Width="38" Height="38" Margin="12,0,0,0" VerticalAlignment="Center" Content="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#FFE9F2FF" Background="#44354860" BorderBrush="#6087A0C0" BorderThickness="1" ToolTip="切换明亮 / 暗黑模式" Cursor="Hand"/>
     <Button x:Name="HideButton" Style="{StaticResource GlassButtonStyle}" Grid.Column="3" Width="38" Height="38" VerticalAlignment="Center" HorizontalAlignment="Right" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FFE9F2FF" Background="#44354860" BorderBrush="#6087A0C0" BorderThickness="1" ToolTip="隐藏到托盘" Cursor="Hand"/>
    </Grid>
    <ScrollViewer x:Name="CardScroll" Grid.Row="1" Margin="48,20,48,20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="Transparent" Focusable="False"><Canvas x:Name="CardCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/></ScrollViewer>
<Grid x:Name="ContentArea" Grid.Row="1" Margin="48,12,48,0">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="SystemRow" Height="0"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid x:Name="LocalSection"><Grid.RowDefinitions><RowDefinition Height="53"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel x:Name="LocalSectionHeader"><TextBlock x:Name="LocalEyebrow" Text="LOCAL MACHINE" FontSize="12" FontWeight="Bold" Foreground="#FF79BEFF"/><TextBlock x:Name="LocalTitle" Text="本机 · i9-13900KF + RTX 4070" FontSize="15" Foreground="#FFCFD8E7"/></StackPanel>
      <Grid x:Name="LocalCards" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions></Grid>
     </Grid>
     <Grid x:Name="RemoteSection" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="53"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel x:Name="RemoteSectionHeader"><TextBlock x:Name="RemoteEyebrow" Text="REMOTE COMPUTE" FontSize="12" FontWeight="Bold" Foreground="#FF76E2DE"/><TextBlock x:Name="RemoteTitle" Text="DGX Spark · GB10" FontSize="15" Foreground="#FFCFD8E7"/></StackPanel>
      <Grid x:Name="RemoteCards" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions></Grid>
     </Grid>
     <Grid x:Name="SystemCards" Grid.Row="1" Grid.ColumnSpan="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid>
    </Grid>
    <Grid x:Name="Footer" Grid.Row="2" Margin="48,0,48,0"><TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="12" Foreground="#FFB5C5D7" Text="双击托盘图标 显示 / 隐藏　·　右键切换分辨率与刷新频率"/><TextBlock x:Name="BackdropText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#FFB1C4D3"/></Grid>
   </Grid>
  </Viewbox>
  <Border x:Name="EditToolbar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" CornerRadius="16" Background="#66142337" BorderBrush="#5087A0C0" BorderThickness="1" Padding="8,4">
   <StackPanel Orientation="Horizontal">
    <Button x:Name="EditModeSwitch" Style="{StaticResource GlassButtonStyle}" Content="卡片编辑" Width="88" Height="28" FontSize="12" Foreground="#FFE9F2FF" Background="#44354860" BorderBrush="#6087A0C0" BorderThickness="1" Cursor="Hand" ToolTip="在卡片编辑与面板调整之间切换"/>
    <Button x:Name="EditScaleDown" Style="{StaticResource GlassButtonStyle}" Content="−" Width="30" Height="28" Margin="6,0,0,0" FontSize="14" Foreground="#FFE9F2FF" Background="#44354860" BorderBrush="#6087A0C0" BorderThickness="1" Cursor="Hand" ToolTip="缩小"/>
    <TextBlock x:Name="EditScaleLabel" Text="100%" Width="52" Height="28" LineHeight="28" TextAlignment="Center" FontSize="13" Foreground="#FFDCE8F7"/>
    <Button x:Name="EditScaleUp" Style="{StaticResource GlassButtonStyle}" Content="+" Width="30" Height="28" FontSize="14" Foreground="#FFE9F2FF" Background="#44354860" BorderBrush="#6087A0C0" BorderThickness="1" Cursor="Hand" ToolTip="放大"/>
    <Button x:Name="EditLayerButton" Style="{StaticResource GlassButtonStyle}" Content="图层" Width="56" Height="28" Margin="6,0,0,0" FontSize="12" Foreground="#FFE9F2FF" Background="#44354860" BorderBrush="#6087A0C0" BorderThickness="1" Cursor="Hand" ToolTip="切换窗口图层：置顶 / 普通 / 置底"/>
    <Button x:Name="DesktopAdjustDone" Style="{StaticResource GlassButtonStyle}" Content="完成调整" Visibility="Collapsed" Width="112" Height="28" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" BorderThickness="1" Cursor="Hand" ToolTip="保存位置和大小"/>
   </StackPanel>
  </Border>
  <StackPanel x:Name="ResizeActions" Orientation="Horizontal" Margin="0,0,6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
   <Button x:Name="ResizeGrip" Style="{StaticResource GlassButtonStyle}" Content="↘" Width="30" Height="30" FontSize="16" Foreground="#AABCD4EF" Background="#33405A70" BorderBrush="#5087A0C0" BorderThickness="1" Cursor="SizeNWSE" ToolTip="拖动调整大小"/>
  </StackPanel>
 </Grid>
</Window>